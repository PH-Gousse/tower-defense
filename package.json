{
  "name": "tower-defense",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "dev": "pnpm --filter @ltw/client dev",
    "build": "pnpm --filter @ltw/client build",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm -r test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "eslint": "^9.36.0",
    "typescript-eslint": "^8.45.0",
    "typescript": "^5.9.0"
  }
}
